{
  "_doc": [
    "Feature vocabulary for E2E selection (owner request 2026-10-08 17:50). A test carries @Tag(\"feature-<name>\") for every",
    "feature whose behaviour it asserts. Each repo maps its source files to features. Rule format: [regex searched in the",
    "repo-relative path, [features]]. A file gets the union of every matching rule; '*' means every feature the repo lists;",
    "ALL means every feature in the vocabulary (cross-cutting code). With strict=true an unmatched file is a gate failure;",
    "otherwise it falls back to the repo's 'fallback'. 'no-e2e' marks code no E2E test can observe (notifications, test",
    "infrastructure); the selector names it instead of selecting tests. Validated by validate_feature_tags.py."
  ],
  "features": {
    "shell": "app shell: routing, navigation, portal chrome, gateway, responsive/accessibility, reload recovery, harness probes",
    "auth": "login, OTP, sessions and session limits, admin step-up, registration of a fresh person",
    "organisations": "business hub, members, invitations, entitlements, portal launcher",
    "partner-onboarding": "restaurant and rider applications, KYC/verification, admin partner approvals",
    "catalog": "restaurant discovery, search, outlets, menus, stock, categories, menu management",
    "addresses": "customer saved addresses, delivery-location selection, places autocomplete",
    "cart-checkout": "cart, quote, delivery pricing, payment choice, tip, order placement, payment capture",
    "order-tracking": "customer tracker, active orders, history, reorder, live ETA, maps",
    "restaurant-orders": "kitchen queue, accept, prepare, ready, delay requests",
    "rider-delivery": "rider duty, dispatch, pickup/delivery OTP, rider history and trips",
    "cancellation": "customer cancel, restaurant reject, platform and timeout auto-cancel",
    "refunds-support": "support tickets, refund quotes, decisions, retries",
    "chat": "order chat sessions, messages, attachments, WebSocket",
    "reviews": "order-scoped reviews, aggregates, review moderation reads",
    "money-ledger": "ledger, payouts, earnings, order money, money operations, reconciliation",
    "wallet": "customer store credit and business wallet, top-ups, statements",
    "ads": "advertisers, campaigns, creatives, bidding, budgets, sponsored listings, tracking",
    "admin-ops": "admin live ops, fleet map, dispatch safety, manual interventions, user management",
    "settings-profile": "profile, settings tabs, theme/appearance"
  },
  "behaviour_tags": ["parked", "slow", "auto-cancel", "auth-rate-limit", "measurement", "ui-only", "browser-routed", "routed-ui", "smoke"],
  "exclude": ["(^|/)src/test/", "\\.md$", "(^|/)\\.github/", "(^|/)node_modules/", "(^|/)target/", "(^|/)dist/", "\\.DS_Store$", "\\.orig$",
              "\\.test\\.tsx?$", "^src/tests/", "^src/mocks/", "(^|/)\\.mvn/", "^mvnw", "\\.gitignore$", "\\.iml$"],
  "repos": {
    "FoodDeliveryAppUI": {
      "include": ["^src/", "^index\\.html$", "^package\\.json$", "^vite\\.config\\.ts$", "^public/", "^tsconfig.*\\.json$", "^tailwind\\.config\\.", "^postcss\\.config\\.", "^Dockerfile$", "^nginx.*\\.conf$"],
      "features": ["ALL"],
      "strict": true,
      "rules": [
        ["^src/features/identity/", ["auth"]],
        ["^src/lib/(authFetch|authStore|tokenStore|useSessionToken|sessionKeepAlive|phone|axiosFetchAdapter)\\.ts$", ["auth", "shell"]],
        ["^src/shared/ui/ActiveSessions\\.tsx$", ["auth"]],
        ["^src/features/organisations/", ["organisations"]],
        ["^src/pages/business/(BusinessHub|OrganisationPage)\\.tsx$", ["organisations"]],
        ["^src/shared/ui/navigation/(PortalLauncher|PersonGuard|RoleGuard|activePortal|organisationContext)\\.tsx?$", ["organisations", "shell"]],
        ["^src/features/(partner-onboarding|kyc)/", ["partner-onboarding"]],
        ["^src/pages/admin/partner-approvals/", ["partner-onboarding"]],
        ["^src/pages/business/RestaurantApplicationPage\\.tsx$", ["partner-onboarding"]],
        ["^src/pages/delivery/DeliveryOnboardingPage\\.tsx$", ["partner-onboarding"]],
        ["^src/features/catalog/", ["catalog"]],
        ["^src/schemas/(menu|restaurant)\\.ts$", ["catalog"]],
        ["^src/features/customer-orders/(components/(AddressDetailsForm|AddressFormFields|AddressSelectionModal|CustomerAddressModal|CustomerAddressPage|CustomerAddressSelectorModal)\\.tsx|model/(addressParts|useAddressAutocomplete|useAddressChangeNotice|useCustomerAddresses)\\.ts)$", ["addresses"]],
        ["^src/shared/ui/SettingsAddressesTab\\.tsx$", ["addresses", "settings-profile"]],
        ["^src/pages/customer/DashboardHeader\\.tsx$", ["addresses", "shell"]],
        ["^src/features/customer-orders/(components/(CustomerCartDrawer|CustomerCheckout|CustomerFreeDeliveryTracker|RiderTipPicker)\\.tsx|model/(useCustomerCart|useDashboardCart)\\.ts)$", ["cart-checkout"]],
        ["^src/shared/ui/(PaymentModal|action/AddToCartControl)\\.tsx$", ["cart-checkout"]],
        ["^src/features/customer-orders/components/(CustomerHomeChrome|CustomerHomeControls|CustomerMainView|CustomerModalStack)\\.tsx$", ["catalog", "cart-checkout", "addresses", "shell"]],
        ["^src/features/customer-orders/(components/(CustomerActiveOrdersCarousel|CustomerLiveOrderRail|CustomerOrderPlacedToast|CustomerOrderTracker|OrderCard|OrderDeliveredSummary|OrderItemList|OrderStatusTimeline|OrderTrackerLive|OrderTrackerSettled|TaxInvoiceSheet)\\.tsx|model/(orderStatus|placedAt|statusMessaging|useCustomerOrders|useTrackedOrder)\\.ts)$", ["order-tracking"]],
        ["^src/features/customer-orders/(components/ReorderStrip\\.tsx|model/(useCustomerReorder|useReorderSuggestions)\\.ts)$", ["order-tracking", "cart-checkout"]],
        ["^src/features/customer-orders/model/useLiveOrderActions\\.ts$", ["order-tracking", "cancellation", "restaurant-orders"]],
        ["^src/features/customer-orders/components/OrderMoneyBreakdown\\.tsx$", ["order-tracking", "money-ledger"]],
        ["^src/features/customer-orders/(components/OrderRefundState\\.tsx|model/useOrderRefunds\\.ts)$", ["refunds-support", "order-tracking"]],
        ["^src/features/customer-orders/components/CustomerOrderChat\\.tsx$", ["chat"]],
        ["^src/features/customer-orders/components/CustomerSettingsScreen\\.tsx$", ["settings-profile"]],
        ["^src/features/customer-orders/model/useCustomerRoute\\.ts$", ["shell"]],
        ["^src/shared/ui/SettingsHistoryTab\\.tsx$", ["order-tracking", "settings-profile"]],
        ["^src/schemas/order\\.ts$", ["order-tracking", "cart-checkout"]],
        ["^src/features/maps-tracking/", ["order-tracking"]],
        ["^src/lib/(olaMaps|polyline)\\.ts$", ["order-tracking", "addresses"]],
        ["^src/utils/geo\\.ts$", ["order-tracking", "addresses", "catalog"]],
        ["^src/features/restaurant-orders/", ["restaurant-orders"]],
        ["^src/pages/restaurant/RestaurantDashboard\\.tsx$", ["restaurant-orders", "shell"]],
        ["^src/pages/restaurant/RestaurantSettingsShell\\.tsx$", ["settings-profile", "catalog"]],
        ["^src/features/delivery-tasks/", ["rider-delivery"]],
        ["^src/pages/delivery/DeliveryDashboard\\.tsx$", ["rider-delivery", "shell"]],
        ["^src/lib/notificationPermissions\\.ts$", ["rider-delivery"]],
        ["^src/features/communication/components/RefundRequestModal\\.tsx$", ["refunds-support", "chat"]],
        ["^src/features/communication/", ["chat"]],
        ["^src/contexts/CallContext\\.tsx$", ["chat"]],
        ["^src/features/reviews/", ["reviews"]],
        ["^src/features/ledger/", ["money-ledger"]],
        ["^src/shared/money/", ["money-ledger"]],
        ["^src/pages/admin/money/(RefundQueue|RefundTicketPanel)\\.tsx$", ["refunds-support"]],
        ["^src/pages/admin/money/(?!RefundQueue|RefundTicketPanel)", ["money-ledger"]],
        ["^src/pages/(restaurant/RestaurantEarningsTab|delivery/RiderEarnings)\\.tsx$", ["money-ledger"]],
        ["^src/pages/delivery/RiderEarnings\\.tsx$", ["rider-delivery"]],
        ["^src/schemas/earnings\\.ts$", ["money-ledger"]],
        ["^src/features/business-wallet/", ["wallet"]],
        ["^src/shared/ui/(SettingsWalletTab|TransactionHistoryTable)\\.tsx$", ["wallet"]],
        ["^src/features/ads-manager/", ["ads"]],
        ["^src/pages/(ads/|admin/ad-creatives/)", ["ads"]],
        ["^src/lib/adTracking\\.ts$", ["ads"]],
        ["^src/features/admin-ops/(components/(AdminSupportTickets|SupportTicketList)\\.tsx|model/refundStatus\\.ts)$", ["refunds-support"]],
        ["^src/schemas/support-ticket\\.ts$", ["refunds-support"]],
        ["^src/features/admin-ops/(components/(AdminLiveOperations|AdminManualInterventions|ManualInterventionList)\\.tsx|model/(dispatchScope|useManualAssignmentCandidates|useManualAssignmentStatus)\\.ts)$", ["admin-ops", "rider-delivery"]],
        ["^src/features/admin-ops/(components/(AdminUserDetailPanel|AdminUserList|AdminUserManagement)\\.tsx|model/(staffRoles|userLookup)\\.ts)$", ["admin-ops"]],
        ["^src/pages/admin/AdminPortal\\.tsx$", ["admin-ops", "shell"]],
        ["^src/shared/ui/(CompleteProfileModal|NamePromptModal|SharedSettingsView)\\.tsx$", ["settings-profile"]],
        ["^src/contexts/ThemeContext\\.tsx$", ["settings-profile"]],
        ["^src/hooks/useUserProfile\\.ts$", ["settings-profile"]],
        ["^src/api/generated/(customer\\.d\\.ts|schemas/customer/)", ["cart-checkout", "order-tracking", "addresses", "cancellation", "refunds-support", "money-ledger", "admin-ops"]],
        ["^src/api/generated/(restaurant\\.d\\.ts|schemas/restaurant/)", ["catalog", "restaurant-orders", "partner-onboarding"]],
        ["^src/api/generated/(delivery\\.d\\.ts|schemas/delivery/)", ["rider-delivery", "partner-onboarding", "admin-ops"]],
        ["^src/api/generated/(identity\\.d\\.ts|schemas/identity/)", ["auth", "organisations", "settings-profile", "admin-ops"]],
        ["^src/api/generated/(chat\\.d\\.ts|schemas/chat/)", ["chat"]],
        ["^src/api/generated/(reviews\\.d\\.ts|schemas/reviews/)", ["reviews"]],
        ["^src/api/generated/(ledger\\.d\\.ts|schemas/ledger/)", ["money-ledger"]],
        ["^src/api/generated/(wallet\\.d\\.ts|schemas/wallet/)", ["wallet"]],
        ["^src/api/generated/(payment\\.d\\.ts|schemas/payment/)", ["cart-checkout", "money-ledger"]],
        ["^src/api/generated/(campaign\\.d\\.ts|schemas/campaign/|tracking\\.d\\.ts|schemas/tracking/)", ["ads"]],
        ["^src/api/generated/(maps\\.d\\.ts|schemas/maps/)", ["order-tracking", "addresses"]],
        ["^src/api/generated/(governmentId\\.d\\.ts|schemas/governmentId/)", ["partner-onboarding"]],
        ["^src/api/generated/[^/]+\\.ts$", ["ALL"]],
        ["^src/pages/customer/(CustomerDashboard|CustomerNavRail)\\.tsx$", ["shell"]],
        ["^src/(App\\.tsx|main\\.tsx|index\\.css|vite-env\\.d\\.ts)$", ["shell"]],
        ["^src/(shared/(ui|time)|hooks|contexts|types|utils|lib|api/manual-schemas|schemas/ui-only)/", ["shell"]],
        ["^(index\\.html|package\\.json|vite\\.config\\.ts|tsconfig.*\\.json|tailwind\\.config\\..*|postcss\\.config\\..*|Dockerfile|nginx.*\\.conf)$", ["ALL"]],
        ["^public/", ["shell"]]
      ]
    },
    "CustomerApplication": {
      "features": ["cart-checkout", "order-tracking", "addresses", "cancellation", "refunds-support", "money-ledger", "restaurant-orders", "catalog", "ads", "admin-ops", "settings-profile", "wallet", "reviews"],
      "strict": true,
      "rules": [
        ["Address", ["addresses"]],
        ["(Refund|SupportTicket|ChatRefund|FaultType|InitiatorType)", ["refunds-support"]],
        ["(Money|ledger/|Ledger|Invoice|Receipt|DriverSummary|RestaurantSummary|SummaryPeriod|Payout|Beneficiary|DailyPayable|DailyTotal|OrderCharge|ChargeEntityType)", ["money-ledger"]],
        ["(Quote|Pricing|DeliveryZone|PaymentIntent|PaymentGatewayOrchestrator|PaymentEventConsumer|RiderTip|OrderRequest|OrderItemRequest|MenuItemsUnavailable|DeliveryPartnerUnavailable|UnpaidOrderCanceller|OrderController|CustomerOrderService)", ["cart-checkout"]],
        ["WalletCheckout", ["cart-checkout", "wallet"]],
        ["(Tracking|/eta/|EstimatedArrival|DeliveryEta|OrderResponse|OrderItemResponse|OrderMapper|OrderController|CustomerOrderService|RedisPubSub)", ["order-tracking"]],
        ["(Cancel|Sweeper|Canceller)", ["cancellation"]],
        ["(DelayApproval|/state/|OrderPrepTime|OrderSagaOrchestrator|OrderEventConsumer|InternalOrderController)", ["restaurant-orders", "order-tracking"]],
        ["(Sponsored|AdServing|Advertisement|AdRequest)", ["ads", "catalog"]],
        ["(Admin(Order|Customer|Dlq)|AdminManual|Manual)", ["admin-ops"]],
        ["AdminDlq", ["money-ledger"]],
        ["(RestaurantClient|RestaurantDto|CustomerRestaurantController|MenuCacheInvalidation|RestaurantApplicationCacheInvalidation|RedisCacheConfig|Places)", ["catalog"]],
        ["Places", ["addresses"]],
        ["(CustomerProfileController|/Customer\\.java|ICustomerRepository|CustomerMcpService)", ["settings-profile"]],
        ["InternalOrderReviewController", ["reviews"]],
        ["(AppConfig|CustomerAppConfig|FilterConfig|SecurityConfig|CustomerIdentityFilter|CustomerSecurityHelper|OrderSecurityHelper|CustomerGlobalExceptionHandler|FoodDeliveryApplication|/entity/Order\\.java|/entity/OrderItem\\.java|IOrderRepository|application.*\\.yml|logback|db/migration/|^pom\\.xml$|^Dockerfile$)", ["*"]]
      ]
    },
    "RestaurantApplication": {
      "features": ["catalog", "restaurant-orders", "partner-onboarding", "refunds-support", "reviews", "money-ledger", "cancellation"],
      "strict": true,
      "rules": [
        ["(Onboarding|Application|Kyc|Verification|ApprovedRestaurants|RestaurantMemberships|ApplicationOutletFactory)", ["partner-onboarding"]],
        ["Beneficiary", ["partner-onboarding", "money-ledger"]],
        ["(Catalog|Category|Menu|Outlet|Override|Brand|Timing|OpeningHours|Stock|ImageUpload|NearbyRestaurant|RestaurantMcp|InternalRestaurantController|RedisCacheConfig)", ["catalog"]],
        ["(Fulfillment|RestaurantOrder|OrderStatus|AcceptOrder|OrderReason|/state/|OrderEventConsumer|DeliveryClient|OrderClient|InternalOrderController)", ["restaurant-orders"]],
        ["(OrderReason|/state/impl/TerminalState)", ["cancellation"]],
        ["PartialRefundRequest", ["refunds-support"]],
        ["ReviewEventConsumer", ["reviews"]],
        ["(RestaurantAccess|SecurityConfig|AppConfig|OpenApiConfig|RestaurantApplication\\.java|application.*\\.yml|logback|db/migration/|^pom\\.xml$|^Dockerfile$)", ["*"]]
      ]
    },
    "DeliveryExecutiveApplication": {
      "features": ["rider-delivery", "partner-onboarding", "admin-ops", "order-tracking", "money-ledger"],
      "strict": false,
      "fallback": ["rider-delivery"],
      "rules": [
        ["(Application|Onboarding|Verification|DailySelfie)", ["partner-onboarding"]],
        ["Beneficiary", ["partner-onboarding", "money-ledger"]],
        ["(AdminDeliveryController|Manual|ForceAssign)", ["admin-ops"]],
        ["(Telemetry|Location|RouteDto|LocationTracking|RedisPubSub)", ["order-tracking"]],
        ["(SecurityConfig|DeliveryExecutiveApplication\\.java|application.*\\.yml|logback|db/migration/|^pom\\.xml$|^Dockerfile$)", ["*"]]
      ]
    },
    "IdentityService": {
      "features": ["auth", "organisations", "partner-onboarding", "admin-ops", "settings-profile"],
      "strict": true,
      "rules": [
        ["/organisation/", ["organisations"]],
        ["/entitlement/", ["organisations"]],
        ["ApplicationStatusConsumer", ["partner-onboarding"]],
        ["AdminAuditController", ["admin-ops"]],
        ["(AdminUserController|StatusUpdateDTO|UserDTO|InternalUserService)", ["admin-ops"]],
        ["(/controller/UserController|ProfileResponseDto|UpdateProfileRequest)", ["settings-profile"]],
        ["(Auth|Session|Otp|E2e|SeededOtp|MaxSessions|UserDevice|certs/|SecurityConfig)", ["auth"]],
        ["(AppUser|/entity/UserRole|UserRepository|UserRoleRepository)", ["auth", "admin-ops", "settings-profile"]],
        ["(IdentityApplication|/adapter/|/port/|IdentityExceptionHandler|application.*\\.yml|logback|db/migration/|^pom\\.xml$|^Dockerfile$)", ["*"]]
      ]
    },
    "PaymentGatewayIntegration": {
      "features": ["cart-checkout", "money-ledger", "refunds-support", "wallet"],
      "strict": false,
      "fallback": ["cart-checkout", "money-ledger"],
      "rules": [
        ["(Refund|MockRefundFailureSeam)", ["refunds-support"]],
        ["(Webhook|Dlq|Reconciliation)", ["money-ledger"]],
        ["Topup", ["wallet"]]
      ]
    },
    "LedgerService": {"features": ["money-ledger", "wallet"], "strict": false, "fallback": ["money-ledger"],
      "rules": [["WalletBalance", ["wallet"]]]},
    "WalletService": {"features": ["wallet", "cart-checkout"], "strict": false, "fallback": ["wallet"], "rules": []},
    "ReviewsService": {"features": ["reviews"], "strict": false, "fallback": ["reviews"], "rules": []},
    "CommunicationService": {"features": ["chat", "refunds-support"], "strict": false, "fallback": ["chat"],
      "rules": [["Refund", ["refunds-support"]]]},
    "MapsIntegration": {"features": ["order-tracking", "addresses", "rider-delivery", "cart-checkout"], "strict": false,
      "fallback": ["order-tracking", "addresses", "rider-delivery", "cart-checkout"], "rules": []},
    "GovernmentIDValidationService": {"features": ["partner-onboarding"], "strict": false, "fallback": ["partner-onboarding"], "rules": []},
    "CampaignService": {"features": ["ads"], "strict": false, "fallback": ["ads"], "rules": []},
    "BiddingEngine": {"features": ["ads"], "strict": false, "fallback": ["ads"], "rules": []},
    "BudgetLimitingService": {"features": ["ads"], "strict": false, "fallback": ["ads"], "rules": []},
    "UserTrackingService": {"features": ["ads"], "strict": false, "fallback": ["ads"], "rules": []},
    "ApiGateway": {"features": ["shell", "auth"], "strict": false, "fallback": ["shell"],
      "rules": [["(/security/|/filter/|Jwt)", ["auth"]]]},
    "IdentitySigning": {"features": ["auth"], "strict": false, "fallback": ["auth"], "rules": []},
    "ConfigService": {"features": ["shell"], "strict": false, "fallback": ["shell"], "rules": []},
    "EurekaServer": {"features": ["shell"], "strict": false, "fallback": ["shell"], "rules": []},
    "CommunicationIntegration": {"features": ["no-e2e"], "strict": false, "fallback": ["no-e2e"], "rules": [],
      "no_e2e_reason": "notifications (SMS/push/email); Dev OTP comes from IdentityService, so no E2E test observes this service"},
    "CommonLibrary": {
      "features": ["ALL"],
      "strict": true,
      "rules": [
        ["^common-test/", ["no-e2e"]],
        ["/event/(Order(Created|Paid|Accepted|Preparing|Ready|StatusUpdated|StatusSync|Scoped|DelayApprovalRequested|DelayApproved)Event)", ["restaurant-orders", "order-tracking"]],
        ["/event/(OrderCancelled\\w*|OrderRejected|OrderDelayRejected|DispatchFailed)Event", ["cancellation"]],
        ["/event/(Driver\\w*|Dispatch\\w*|OutForDelivery|Delivered|DeliveryFailed|ForceAssignDriver|ManualIntervention\\w*|ManualAssignment\\w*|OrderDriverRejected)Event", ["rider-delivery"]],
        ["/event/(ManualIntervention\\w*|ManualAssignment\\w*|ForceAssignDriver)Event", ["admin-ops"]],
        ["/event/(Delivered|OutForDelivery)Event", ["order-tracking"]],
        ["/event/(Payment\\w*|OrderPaid)Event", ["cart-checkout", "money-ledger"]],
        ["/event/(\\w*Refund\\w*|OrderPartiallyRefunded)Event", ["refunds-support", "money-ledger"]],
        ["/event/ReviewCreatedEvent", ["reviews"]],
        ["/event/(Ad\\w*|Campaign\\w*|BudgetAlert|Billing)Event", ["ads"]],
        ["/event/(WalletCreditRequested|BusinessWalletTopupFailed)Event", ["wallet"]],
        ["/event/(MenuCacheInvalidation|BrandCreated)Event", ["catalog"]],
        ["/event/NotificationRequestEvent", ["no-e2e"]],
        ["/event/application/", ["partner-onboarding"]],
        ["/event/organisation/", ["organisations"]],
        ["/event/(EventBinder|EventBindingException|OutboxEvent)\\.java$", ["ALL"]],
        ["/dto/(campaign|targeting)/", ["ads"]],
        ["/dto/governmentid/", ["partner-onboarding"]],
        ["/dto/identity/", ["auth", "organisations"]],
        ["/dto/ledger/", ["money-ledger"]],
        ["/dto/maps/", ["order-tracking", "addresses", "rider-delivery"]],
        ["/dto/order/", ["cart-checkout", "order-tracking", "restaurant-orders"]],
        ["/dto/organisation/", ["organisations"]],
        ["/dto/payment/", ["cart-checkout", "money-ledger"]],
        ["/dto/restaurant/", ["catalog"]],
        ["/dto/wallet/", ["wallet"]],
        ["/dto/[A-Za-z]+\\.java$", ["ALL"]],
        ["/enums/(OrderStatus|DeliveryStatus)\\.java$", ["order-tracking", "restaurant-orders", "rider-delivery", "cancellation"]],
        ["/enums/(PaymentMethod|PaymentGateway|TransactionStatus|TransactionDirection)\\.java$", ["cart-checkout", "money-ledger"]],
        ["/enums/(RefundStatus|RefundDestination|FaultType)\\.java$", ["refunds-support"]],
        ["/enums/(LedgerAccountType|ChargeCategory)\\.java$", ["money-ledger"]],
        ["/enums/WalletEntityType\\.java$", ["wallet"]],
        ["/enums/(Organisation\\w*|MembershipStatus|BusinessType)\\.java$", ["organisations"]],
        ["/enums/(ApplicationStatus|VerificationType|VerificationStatus|VehicleClass)\\.java$", ["partner-onboarding"]],
        ["/enums/ReviewEntityType\\.java$", ["reviews"]],
        ["/enums/(UserRole|RoleName)\\.java$", ["auth", "admin-ops", "organisations"]],
        ["/enums/(ChannelType)\\.java$", ["no-e2e"]],
        ["/enums/(OutboxStatus|AuditAction)\\.java$", ["ALL"]],
        ["/constants/LedgerAccounts\\.java$", ["money-ledger"]],
        ["/constants/PaymentIntentStatus\\.java$", ["cart-checkout"]],
        ["/constants/AdMacroConstants\\.java$", ["ads"]],
        ["/constants/NotificationTemplate\\.java$", ["no-e2e"]],
        ["/constants/(?!LedgerAccounts|PaymentIntentStatus|AdMacroConstants|NotificationTemplate)\\w+\\.java$", ["ALL"]],
        ["/client/Wallet\\w*\\.java$", ["wallet"]],
        ["/client/GovernmentId\\w*\\.java$", ["partner-onboarding"]],
        ["/client/Maps\\w*\\.java$", ["order-tracking", "addresses"]],
        ["/client/Restaurant\\w*\\.java$", ["catalog"]],
        ["/client/Payment\\w*\\.java$", ["cart-checkout", "money-ledger"]],
        ["/client/Organisation\\w*\\.java$", ["organisations"]],
        ["/client/Customer\\w*\\.java$", ["order-tracking", "rider-delivery"]],
        ["/security/money/", ["money-ledger"]],
        ["/security/organisation/", ["organisations"]],
        ["/common/ads/", ["ads"]],
        ["/common/location/", ["order-tracking", "rider-delivery", "addresses"]],
        ["^common-(core|messaging|persistence|storage|web)/(?!src/main/java/com/fooddelivery/common/(event|dto|enums|constants|client|security/money|security/organisation|ads|location)/)", ["ALL"]],
        ["^pom\\.xml$", ["ALL"]]
      ]
    },
    "Deployment": {"include": ["^api-gateway\\.yml$", "^docker-compose.*\\.ya?ml$", "^env_deployments/"], "features": ["shell"], "strict": false, "fallback": ["shell"], "rules": [],
      "note": "deploy configuration: gateway routes and compose. Selects feature-shell; widen with --features when a route for one service changes"},
    "ONDCIntegrationService": {"features": ["no-e2e"], "strict": false, "fallback": ["no-e2e"], "rules": [],
      "no_e2e_reason": "ONDC is parked (compile-and-run only); no E2E test exists"}
  }
}
